# ---------------------------------------------------------------
# NammaSahaay AI — environment variables
# Copy to .env.local. NEVER commit real keys.
# The prototype runs fully WITHOUT any of these (deterministic
# rule-based AI routing + in-memory demo database).
# ---------------------------------------------------------------

# --- AI provider ------------------------------------------------
# Which provider handles natural-language turns: gemini | openai | local | none
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Alternate providers (the app talks only to the AIProvider interface)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=qwen2.5:3b

# --- Database (MongoDB) -----------------------------------------
# The primary database. Leave blank to run on the in-memory demo store
# instead, which needs no infrastructure at all.
#   local docker : docker run -d -p 27017:27017 --name nammasahaay-mongo mongo:7
#   atlas        : mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true
MONGODB_URI=
MONGODB_DB=nammasahaay
# --- Database / storage (Supabase Postgres) — alternative adapter -
# Only used when MONGODB_URI is empty. Kept so the same Database interface
# can run on Postgres without touching application code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Authentication ---------------------------------------------
# Signs the session cookie set at login/registration. MUST be set to a long
# random string in any real deployment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Email ------------------------------------------------------
# Also used to deliver registration/login OTP codes by email. Leave blank for
# the demo email provider (nothing is actually sent; the demo shows the code).
EMAIL_API_KEY=
EMAIL_FROM=NammaSahaay Demo <demo@example.com>

# --- Prototype safety -------------------------------------------
# Demo mode keeps every government integration simulated. Keep this true.
NEXT_PUBLIC_DEMO_MODE=true
